# Used by docker compose (MongoDB) AND by the Express server (server/src/config.js)
MONGO_PASSWORD=mongo123
MONGODB_URI=mongodb://gdpr_user:mongo123@127.0.0.1:27018/gdpr_analyzer?authSource=admin

# Express API
PORT=8000
# Python interpreter that has requirements.txt installed
# (e.g. venv/bin/python on Mac/Linux, or venv\Scripts\python.exe on Windows)
PYTHON_BIN=venv/Scripts/python.exe
SCAN_TIMEOUT_MS=180000
MAX_CONCURRENT_SCANS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
